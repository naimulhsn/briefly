PORT=3000
NODE_ENV=production
# Used to sign login sessions. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me
# Optional. If set, POST /api/ingest/run requires header X-Ingest-Secret.
INGEST_SECRET=
# Asia/Dhaka is hardcoded for the 6:00 and 18:00 jobs.
# Google Gemini (preferred). A Groq key is used only if Gemini fails.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GROQ_API_KEY=
# Cap AI calls per briefing to stay on the free tier.
MAX_AI_CLUSTERS=48
AI_BATCH_SIZE=4
# Optional override; default is ./data/briefly.db
# DATABASE_PATH=/data/briefly.db
# Set true behind HTTPS reverse proxies (Render, Fly, etc.)
COOKIE_SECURE=false

# In production, point at Turso instead of a local file:
# TURSO_DATABASE_URL=libsql://briefly-<org>.turso.io
# TURSO_AUTH_TOKEN=

# Optional summarization fallbacks (used if Gemini fails or is unset):
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# CEREBRAS_API_KEY=
# MISTRAL_API_KEY=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# Optional embedding fallbacks if Gemini is unset:
# JINA_API_KEY=
# COHERE_API_KEY=
